   "source": [
    "# Formula:W = F * d * Cos theta W= Work Done, F= Force, d= distance, theta= Angle in degrees"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "0c4ea2b1-0adf-49ba-be71-90f2a0acedae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter Force in Newton:   10\n",
      "Enter distance in meter:   5\n",
      "Enter angle in degrees:   1\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Work Done is: 49.992384757819565 Joule\n"
     ]
    }
   ],
   "source": [
    "import math\n",
    "\n",
    "f=float(input(\"Enter Force in Newton:  \"))\n",
    "d=float(input(\"Enter distance in meter:  \"))\n",
    "theta_deg=float(input(\"Enter angle in degrees:  \"))\n",
    "\n",
    "theta_rad =math.radians (theta_deg)\n",
    "\n",
    "W= f*d*math.cos(theta_rad)\n",
    "\n",
    "print(\"Work Done is:\",W, \"Joule\")"
   ]
  },

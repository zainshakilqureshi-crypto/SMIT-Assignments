   "source": [
    "# Q11.Quadritic Equation Roots"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6c23bce2-8a61-41e4-ac91-36adca522069",
   "metadata": {},
   "source": [
    "# Formula: X =(-b+- sqrt(b^2-4ac)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "872860b1-cf7e-4185-b8fe-b4d930517858",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter coefficient a:  1\n",
      "Enter coefficient b:  5\n",
      "Enter coefficient c:  6\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "two real roots are: -2.0 and -3.0\n"
     ]
    }
   ],
   "source": [
    "import math \n",
    "a =float(input(\"Enter coefficient a: \"))\n",
    "b =float(input(\"Enter coefficient b: \"))\n",
    "c =float(input(\"Enter coefficient c: \"))\n",
    "\n",
    "d= (b**2) - (4*a*c)  # discriminant\n",
    "if d > 0:\n",
    "    root1= (-b + math.sqrt(d)) / (2*a)\n",
    "    root2= (-b - math.sqrt(d)) / (2*a)\n",
    "    print(\"two real roots are:\", root1, \"and\", root2)\n",
    "elif d==0:\n",
    "    root = -b / (2*a)\n",
    "    print(\"one real root is:\", root)\n",
    "else:\n",
    "    real =-b / (2*a)\n",
    "    imag = math.sqrt(-d) / (2*a)\n",
    "    print(\"complex roots are:\",real, \"+\", imag, \"i and\",real, \"-\", imag, \"i\") \n"
   ]
  },

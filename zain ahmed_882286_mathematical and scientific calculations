   "source": [
    "# Formula: Q=m * c * delta T  Q= Heat Transfer, m= mass, c= Specific Heat Capicity delta t= Change in Tempreature= T2 - T1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "7ae7c687-d601-452f-b0f8-ad10a86843d8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter Mass in kg:   2\n",
      "Enter Specific Heat capicity in J/kg C:   4186\n",
      "Enter initial tempreature in C:   20\n",
      "Enter Final tempreature in C:   70\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Heat Transfer is: 418600.0 Joule\n"
     ]
    }
   ],
   "source": [
    "m=float(input(\"Enter Mass in kg:  \"))\n",
    "c=float(input(\"Enter Specific Heat capicity in J/kg C:  \"))\n",
    "T1=float(input(\"Enter initial tempreature in C:  \"))\n",
    "T2=float(input(\"Enter Final tempreature in C:  \"))\n",
    "\n",
    "delta_T = T2 - T1\n",
    "\n",
    "Q = m * c * delta_T\n",
    "\n",
    "print(\"Heat Transfer is:\",Q, \"Joule\")"
   ]
